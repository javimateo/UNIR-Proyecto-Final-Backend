@BASE_URL = http://localhost:3000/api
@TOKEN = 

########################---AUTH---###############################

### PRIMERO: Registrate (solo la primera vez)
POST {{BASE_URL}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "password123"
}

### SEGUNDO: Inicia sesión para obtener token (hacer esto siempre que el token expire)
# El token aparecerá en la respuesta - cópialo y pégalo en la línea: @TOKEN = <token_aqui>
POST {{BASE_URL}}/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123"
}

### Ver token actual
GET {{BASE_URL}}/auth/me
Authorization: Bearer {{TOKEN}}


########################---GETS---###############################

#### Listar categorías
GET {{BASE_URL}}/categories


### Listar favoritos
GET {{BASE_URL}}/favorites
Authorization: Bearer {{TOKEN}}


### Listar items con búsqueda y filtros
GET {{BASE_URL}}/items?search=Samsung&category=1&priceMin=100&priceMax=500&sort=price_asc&page=1&limit=10
Authorization: Bearer {{TOKEN}}

### Obtener item por ID
GET {{BASE_URL}}/items/1



########################---POSTS---###############################

### Crear categoría
POST {{BASE_URL}}/categories
Content-Type: application/json

{
  "name": "Pantallas SuperGigantes (86\" - 95\")"
}



### Guardar favorito
POST {{BASE_URL}}/favorites
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "item_id": 5
}


### Crear item
POST {{BASE_URL}}/items
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "category_id": 1,
  "brand_id": 1,
  "title": "Samsung TV 32 pulgadas",
  "model": "UE32T4305",
  "description": "TV LED de buena calidad",
  "specs": {
    "resolucion": "FHD 1080p",
    "hdmi": 2,
    "panel": "LED"
  },
  "price": 250.00,
  "item_condition": "like_new"
}





########################---PUTS---###############################

### Actualizar item
PUT {{BASE_URL}}/items/1
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "title": "Samsung TV 32 pulgadas (nuevo precio)",
  "price": 199.99,
  "item_condition": "good",
  "status": "published"
}



### Actualizar categoría
PUT {{BASE_URL}}/categories/5
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "name": "Pantallas SuperGigantes (86\" - 100\")"
}





########################---DELETES---###############################

### Eliminar categoría
DELETE {{BASE_URL}}/categories/5
Authorization: Bearer {{TOKEN}}

### Eliminar favorito
DELETE {{BASE_URL}}/favorites/5
Authorization: Bearer {{TOKEN}}

### Eliminar item
DELETE {{BASE_URL}}/items/1
Authorization: Bearer {{TOKEN}}